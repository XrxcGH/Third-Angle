{
  "name": "third-angle",
  "version": "0.1.0",
  "private": true,
  "description": "Eric J. Dean, multi-discipline engineering portfolio. Server-rendered Node, Express, EJS, and node:sqlite.",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "admin": "node scripts/create-admin.js",
    "seed": "node scripts/seed.js",
    "seed:pages": "node scripts/seed-pages.js",
    "seed:edu": "node scripts/seed-education.js",
    "preview": "node scripts/snapshot.mjs",
    "reset-db": "node scripts/seed.js --reset",
    "fonts": "node scripts/fetch-fonts.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "DATA_DIR=.test-data node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "check:scope": "node scripts/scope-guard.mjs",
    "check:contrast": "node --test tests/contrast.test.mjs",
    "check:costs": "node scripts/check-costs.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:doc-facts": "node scripts/check-doc-facts.mjs",
    "pretest": "node scripts/test-db.mjs"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "fractional-indexing": "^4.0.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.3"
  }
}
