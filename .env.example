# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# Set by scripts/seed.js on first run.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Eric J. Dean
ADMIN_PASSWORD=change-me-before-first-run

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. A fine-grained token with public repo read scope only, which raises
# the API rate limit from 60 an hour to 5000. The profile is public, so a
# rejected or expired token is not fatal: the fetch falls back to anonymous and
# says so in the admin.
GITHUB_TOKEN=
GITHUB_USER=XrxcGH

# The LinkedIn vanity name, the part after /in/.
LINKEDIN_USER=edean07

# Outbound mail, for forwarding contact messages. Every message is stored in the
# admin inbox whether or not this is set, so leaving it blank costs a
# notification and never a message.
#
# 465 is implicit TLS, 587 is STARTTLS, and both are supported. Port 25 is not,
# and neither is an unencrypted session: a relay that does not offer STARTTLS on
# 587 is refused rather than sent a password in the clear.
#
# With Gmail this must be an app password, not the account password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER. This is the From address; the visitor goes in
# Reply-To, because putting them in From fails SPF and lands the mail in spam.
SMTP_FROM=
