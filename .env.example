# Copy to .env and fill in. Never commit .env: it is in .gitignore, and
# deploy/githooks/pre-commit refuses a commit that would add a credential.
#
# This file is DEVELOPMENT. Production does not read it at all — the server
# reads /etc/third-angle/env, which deploy/provision.sh writes and which carries
# SITE_URL=https://ericjdean.com. See DEPLOY.md.
NODE_ENV=development
PORT=3000

# Development only. Every absolute URL derives from this: the canonical link,
# og:url, every <loc> in the sitemap, both feeds, and the Contact line in
# security.txt. In production it is https://ericjdean.com, and the boot check in
# src/db.js refuses to start on anything that is not https, or that still says
# example.com or localhost.
SITE_URL=http://localhost:3000

# The admin account is NOT created from this file. Run:
#   npm run admin -- <email> <name> <password>
# The password must be at least 12 characters, unless you add --temp for a
# hand-over credential you intend to replace at first sign in.

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. A fine-grained token with public repo read scope only, which raises
# the API rate limit from 60 an hour to 5000. The profile is public, so a
# rejected or expired token is not fatal: the fetch falls back to anonymous and
# says so in the admin.
GITHUB_TOKEN=
GITHUB_USER=XrxcGH

# The LinkedIn vanity name, the part after /in/.
LINKEDIN_USER=edean07

# Outbound mail, for forwarding contact messages. Every message is stored in the
# admin inbox whether or not this is set, so leaving it blank costs a
# notification and never a message.
#
# 465 is implicit TLS, 587 is STARTTLS, and both are supported. Port 25 is not,
# and neither is an unencrypted session: a relay that does not offer STARTTLS on
# 587 is refused rather than sent a password in the clear.
#
# Brevo, on 587. Three things are easy to get wrong here, and each fails with a
# message that does not explain itself:
#
#   SMTP_USER is the LOGIN from Brevo's SMTP & API page, not the address you
#   sign in to Brevo with. It is usually generated, of the form
#   9xxxxxx@smtp-brevo.com.
#
#   SMTP_PASS is an SMTP KEY generated on that same page, not the Brevo account
#   password.
#
#   SMTP_FROM must be a sender Brevo has verified, or every send is rejected.
#   Verify the domain rather than one address and mail comes from
#   contact@ericjdean.com instead of somebody's personal account: add Brevo's
#   DKIM and SPF records at Cloudflare, which is already answering for the zone.
#
# Left blank, nothing breaks. Every message is stored in the admin inbox either
# way and the mail column reads "no smtp" until this is filled in.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER, which for Brevo is a generated address nobody
# should see, so set it. The visitor goes in Reply-To rather than From, because
# putting them in From fails SPF and lands the mail in spam.
SMTP_FROM=
