[Unit]
Description=Assert Litestream is still replicating
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/third-angle/env
# Scrapes the metrics endpoint and asserts the replica sync timestamp has
# advanced since the last scrape. This catches process death, which tailing
# the log does not.
ExecStart=/usr/local/bin/third-angle-alive
