# Caddy. Automatic TLS from Let's Encrypt, no configuration needed for certs.
#
# Install to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
# Replace example.com with the real domain before first run.

example.com, www.example.com {
	encode zstd gzip

	# The retry is what makes a systemd restart invisible. Caddy holds the
	# connection and retries for up to five seconds rather than returning 502
	# while the new process is coming up, which is why blue/green is not needed.
	reverse_proxy 127.0.0.1:3000 {
		lb_try_duration 5s
		lb_try_interval 250ms
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}

	# A static page for when Node is genuinely down rather than restarting.
	handle_errors {
		@down expression {err.status_code} in [502, 503, 504]
		handle @down {
			rewrite * /maintenance.html
			root * /srv/third-angle/deploy
			file_server
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output file /var/log/caddy/third-angle.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
