<!doctype html>
<%
  /* theme is 'system' | 'light' | 'dark'. 'system' emits NO attribute, so
     prefers-color-scheme decides. Rendered server side from a cookie, so there
     is no flash of the wrong theme and no inline script. */
  const themeAttr = (theme === 'light' || theme === 'dark') ? ` data-theme="${theme}"` : '';
  const SITE = 'Eric J. Dean';
  const pageTitle = (!title || title === SITE) ? SITE : `${title} · ${SITE}`;
%>
<html lang="en"<%- themeAttr %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %></title>
<% if (description) { %><meta name="description" content="<%= description %>"><% } %>
<link rel="canonical" href="<%= canonical %>">

<meta property="og:type" content="website">
<meta property="og:title" content="<%= pageTitle %>">
<% if (description) { %><meta property="og:description" content="<%= description %>"><% } %>
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="Eric J. Dean">
<meta name="twitter:card" content="summary_large_image">
<%
  /* Crawlers fetch only this first response and never run JavaScript, which is
     exactly why a server rendered stack is an advantage here rather than a
     compromise. Absolute URLs: several platforms will not resolve a relative one. */
  /* An uploaded card wins over the generated one, and the generated one wins
     over the site-wide default. A page that names its own card is the most
     specific answer available, so it is checked first. */
  const uploadedOg = ci('site.og.image');
  const og = (typeof ogImage !== 'undefined' && ogImage) ? ogImage
    : uploadedOg ? `/media/${uploadedOg.storage_key}`
    : '/og/default.png';
%>
<meta property="og:image" content="<%= siteUrl + og %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="<%= title || 'Eric J. Dean' %>">
<% if (typeof jsonLd !== 'undefined' && jsonLd) { %>
<script type="application/ld+json"><%- jsonLd %></script>
<% } %>

<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="alternate" type="application/atom+xml" title="Eric J. Dean" href="/feed.xml">
<link rel="alternate" type="application/feed+json" title="Eric J. Dean" href="/feed.json">
<link rel="stylesheet" href="/static/css/fonts.css">
<link rel="stylesheet" href="/static/css/tokens.css">
<link rel="stylesheet" href="/static/css/app.css">
<link rel="stylesheet" href="/static/css/icons.css">
<link rel="stylesheet" href="/static/css/motion.css">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>

<%- include('partials/header') %>

<main id="main">
<%- body %>
</main>

<%- include('partials/footer') %>
</body>
</html>
