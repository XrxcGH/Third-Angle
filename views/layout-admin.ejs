<!doctype html>
<%
  const themeAttr = (theme === 'light' || theme === 'dark') ? ` data-theme="${theme}"` : '';
%>
<html lang="en"<%- themeAttr %>>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · Admin</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/static/css/fonts.css">
<link rel="stylesheet" href="/static/css/tokens.css">
<link rel="stylesheet" href="/static/css/app.css">
<link rel="stylesheet" href="/static/css/admin.css">
<link rel="stylesheet" href="/static/css/motion.css">
</head>
<body class="admin">
<a class="skip-link" href="#main">Skip to content</a>

<header class="admin-bar">
  <div class="wrap bar">
    <a class="brand" href="/admin">
      <%- include('partials/mark', { size: 26 }) %>
      <span class="wordmark">ADMIN</span>
    </a>
    <% if (typeof session !== 'undefined' && session) { %>
      <% const here = (p) => (path === p || path.startsWith(p + '/')) ? ' aria-current="page"' : ''; %>
      <nav class="nav" aria-label="Admin">
        <a href="/admin/content"<%- here('/admin/content') %>>Content</a>
        <a href="/admin/projects"<%- here('/admin/projects') %>>Projects</a>
        <a href="/admin/media"<%- here('/admin/media') %>>Media</a>
        <a href="/admin/documents"<%- here('/admin/documents') %>>Documents</a>
        <a href="/admin/facets"<%- here('/admin/facets') %>>Disciplines</a>
        <a href="/admin/education"<%- here('/admin/education') %>>Education</a>
        <a href="/admin/photos"<%- here('/admin/photos') %>>Photos</a>
        <a href="/admin/notes"<%- here('/admin/notes') %>>Log</a>
        <a href="/admin/messages"<%- here('/admin/messages') %>>Messages</a>
        <a href="/admin/settings"<%- here('/admin/settings') %>>Settings</a>
        <a href="/admin/account"<%- here('/admin/account') %>>Account</a>
        <a href="/" target="_self">View Site</a>
      </nav>
      <form class="signout" method="post" action="/admin/logout" style="margin-left:auto;">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn btn-quiet" type="submit">Sign Out</button>
      </form>
    <% } %>
  </div>
</header>

<main id="main" class="wrap" style="padding-block: var(--s-5) var(--s-7);">
<%
  /* A temporary password that nobody is reminded about is just a weak
     password. The banner is on every admin page rather than only the account
     page, because the account page is the one page the operator is least
     likely to open. */
%>
<% if (typeof mustChangePassword !== 'undefined' && mustChangePassword) { %>
  <p class="flash error" role="status">
    This account is still on a temporary password, so the rest of the admin is
    closed until it is replaced. Set a permanent one below, and turn on two
    factor authentication while you are here.
  </p>
<% } %>
<%- body %>
</main>
</body>
</html>
