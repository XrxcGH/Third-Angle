<article class="wrap" style="padding-top: var(--s-6);">
  <p class="eyebrow"><%= page.slug === 'resume' ? 'Resume' : 'About' %></p>
  <h1><%= page.title %></h1>
  <% if (page.subtitle) { %>
    <p class="lede prose" style="color: var(--text-muted); margin-top: var(--s-3);"><%= page.subtitle %></p>
  <% } %>

  <% if (pdf) { %>
    <div class="chips" style="margin-top: var(--s-4);">
      <%
        /* Both formats, and neither gated. A PDF alone is nearly invisible to
           a name search, and a recruiter should not have to download a file to
           read one page. Gating a student resume behind an email form costs
           exactly the reviewer you want. */
      %>
      <a class="chip" href="<%= pdf %>">Open the PDF</a>
      <a class="chip" href="/contact">Get in touch</a>
    </div>
  <% } %>

  <div class="prose section"><%- page.body_html %></div>

  <p class="eyebrow" style="margin-top: var(--s-6);">
    Updated <time datetime="<%= page.updated_at %>"><%= page.updated_at.slice(0, 10) %></time>
  </p>
</article>
