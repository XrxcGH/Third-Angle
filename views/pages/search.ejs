<section class="wrap pad-top">
  <p class="eyebrow"><%= c('search.eyebrow') %></p>
  <h1><%= c('search.heading') %></h1>

  <form method="get" action="/search" role="search" class="searchbar" style="margin-top: var(--s-4);">
    <label class="visually-hidden" for="q"><%= c('search.label') %></label>
    <input class="input" id="q" name="q" type="search" value="<%= q %>"
           placeholder="<%= c('search.placeholder') %>"
           autocomplete="off" spellcheck="false">
    <button class="btn" type="submit"><%= c('search.button') %></button>
  </form>

  <% if (q) { %>
    <p class="eyebrow" role="status" style="margin-top: var(--s-4);">
      <%= results.length %> <%= c('search.results.for') %><%= results.length === 1 ? '' : 's' %> <%= c('search.results.forword') %> &ldquo;<%= q %>&rdquo;<%
        if (fallback && fallback.kind === 'corrected') { %> &middot; <%= c('search.results.corrected') %> &ldquo;<%= fallback.term %>&rdquo;<%
        } else if (fallback && fallback.kind === 'near') { %> &middot; <%= c('search.results.near') %><% } %>
    </p>

    <div class="stack" style="margin-top: var(--s-3);">
      <% for (const r of results) { %>
        <a href="<%= r.url %>" style="text-decoration:none; display:block; padding: var(--s-3) 0; border-bottom: 1px solid var(--hairline);">
          <span class="eyebrow" style="margin:0;"><%= r.kind %></span>
          <span style="display:block; font-family: var(--f-display); font-weight: var(--w-head); font-size:1.05rem; color: var(--text-strong);"><%= r.title %></span>
          <% if (r.excerpt) { %><span style="display:block; color: var(--text-muted); font-size:.95rem;"><%- r.excerpt %></span>
          <% } else if (r.subtitle) { %><span style="display:block; color: var(--text-muted); font-size:.95rem;"><%= r.subtitle %></span><% } %>
        </a>
      <% } %>
      <% if (!results.length) { %>
        <p style="color: var(--text-muted);"><%= c('search.empty') %></p>
      <% } %>
    </div>
  <% } %>
</section>
