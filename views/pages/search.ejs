<section class="wrap" style="padding-top: var(--s-6);">
  <p class="eyebrow">Search</p>
  <h1>Find anything</h1>

  <form method="get" action="/search" role="search" style="margin-top: var(--s-4); display:flex; gap: var(--s-2); max-width: 34rem;">
    <label class="visually-hidden" for="q">Search projects, documents and disciplines</label>
    <input id="q" name="q" type="search" value="<%= q %>" placeholder="swerve, CAN bus, governance, MegaTag2"
           autocomplete="off" spellcheck="false"
           style="flex:1; font-family: var(--f-body); font-size: 1rem; padding: 10px 12px; border-radius: var(--r-control); border:1px solid var(--hairline); background: var(--surface); color: var(--text-body);">
    <button type="submit" style="font-family: var(--f-mono); font-size:.66rem; letter-spacing:.12em; text-transform:uppercase; padding: 10px 16px; border-radius: var(--r-control); border:1px solid var(--accent); background: var(--accent); color: var(--on-accent); cursor:pointer;">Search</button>
  </form>

  <% if (q) { %>
    <p class="eyebrow" role="status" style="margin-top: var(--s-4);">
      <%= results.length %> result<%= results.length === 1 ? '' : 's' %> for &ldquo;<%= q %>&rdquo;<%
        if (fallback && fallback.kind === 'corrected') { %> &middot; showing results for &ldquo;<%= fallback.term %>&rdquo;<%
        } else if (fallback && fallback.kind === 'near') { %> &middot; showing near matches<% } %>
    </p>

    <div class="stack" style="margin-top: var(--s-3);">
      <% for (const r of results) { %>
        <a href="<%= r.url %>" style="text-decoration:none; display:block; padding: var(--s-3) 0; border-bottom: 1px solid var(--hairline);">
          <span class="eyebrow" style="margin:0;"><%= r.kind %></span>
          <span style="display:block; font-family: var(--f-display); font-weight:650; font-size:1.05rem; color: var(--text-strong);"><%= r.title %></span>
          <% if (r.excerpt) { %><span style="display:block; color: var(--text-muted); font-size:.95rem;"><%- r.excerpt %></span>
          <% } else if (r.subtitle) { %><span style="display:block; color: var(--text-muted); font-size:.95rem;"><%= r.subtitle %></span><% } %>
        </a>
      <% } %>
      <% if (!results.length) { %>
        <p style="color: var(--text-muted);">Nothing matched. Try a discipline name, a part, or a tool.</p>
      <% } %>
    </div>
  <% } %>
</section>
