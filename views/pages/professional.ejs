<section class="wrap pad-top">
  <p class="eyebrow">Professional</p>
  <h1>The Public Record</h1>
  <p class="lede prose" style="color: var(--text-muted);">
    Repositories and profile, read here rather than somewhere else. The GitHub
    data below is fetched by this server and cached, so nothing on this page
    calls out to anyone while you read it.
  </p>

  <div class="profile-grid" style="margin-top: var(--s-5);">

    <%# --------------------------------------------------------------- GitHub %>
    <section class="panel" aria-labelledby="gh-heading">
      <% if (gh.profile) { %>
        <div class="profile-head">
          <%
            /* The avatar is proxied through this origin rather than hotlinked
               from avatars.githubusercontent.com. img-src in the CSP is 'self'
               and data:, and relaxing it for a third party host to render one
               56px square would be a poor trade. */
          %>
          <img src="/avatar/github.png" width="56" height="56" loading="lazy" decoding="async"
               alt="GitHub profile picture for <%= gh.profile.login %>">
          <span>
            <span class="profile-name" id="gh-heading"><%= gh.profile.name %></span>
            <a class="mono" style="font-size:.75rem;" href="<%= gh.profile.url %>" rel="me noopener">
              github.com/<%= gh.profile.login %>
            </a>
          </span>
        </div>

        <% if (gh.profile.bio) { %>
          <p style="margin: 0 0 var(--s-3); font-size:.95rem;"><%= gh.profile.bio %></p>
        <% } %>

        <div class="metrics" style="margin-bottom: var(--s-4);">
          <div class="metric">
            <div class="metric-value tnum"><%= gh.profile.publicRepos %></div>
            <div class="metric-label">Public Repositories</div>
          </div>
          <div class="metric">
            <div class="metric-value tnum"><%= gh.totalStars %></div>
            <div class="metric-label">Stars</div>
          </div>
          <div class="metric">
            <div class="metric-value tnum"><%= gh.profile.followers %></div>
            <div class="metric-label">Followers</div>
          </div>
          <% if (gh.profile.createdAt) { %>
            <div class="metric">
              <div class="metric-value tnum"><%= gh.profile.createdAt.slice(0, 4) %></div>
              <div class="metric-label">Since</div>
            </div>
          <% } %>
        </div>

        <% if (gh.languages.length) { %>
          <p class="eyebrow" style="margin-bottom: var(--s-2);">Languages by Repository</p>
          <div class="chips" style="margin-bottom: var(--s-4);">
            <% for (const l of gh.languages.slice(0, 6)) { %>
              <span class="chip"><%= l.language %> <span class="tnum" style="color: var(--text-muted);"><%= l.share %>%</span></span>
            <% } %>
          </div>
        <% } %>

      <% } else { %>
        <h2 id="gh-heading" style="margin-bottom: var(--s-2);">GitHub</h2>
        <p style="color: var(--text-muted); font-size:.95rem;">
          <% if (!settings.github_live) { %>
            Live GitHub data is switched off in the admin, and nothing has been cached yet.
          <% } else { %>
            The GitHub data has not been fetched yet. It loads on the next request,
            or immediately from the admin.
          <% } %>
        </p>
        <p style="margin-bottom:0;">
          <a href="https://github.com/<%= gh.username %>" rel="me noopener">github.com/<%= gh.username %></a>
        </p>
      <% } %>
    </section>

    <%# ------------------------------------------------------------- LinkedIn %>
    <section class="panel" aria-labelledby="li-heading">
      <div class="profile-head">
        <span class="icon-host" style="color: var(--patina);">
          <%- include('../partials/icon', { name: 'business', size: 34 }) %>
        </span>
        <span>
          <span class="profile-name" id="li-heading">LinkedIn</span>
          <a class="mono" style="font-size:.75rem;" href="<%= linkedin.url %>" rel="me noopener">
            linkedin.com/in/<%= linkedin.handle %>
          </a>
        </span>
      </div>

      <%
        /*
         * Why this is a card and not a live embed.
         *
         * There is no public LinkedIn profile API without a partner agreement,
         * and a profile page cannot be framed: LinkedIn serves
         * X-Frame-Options: DENY specifically to prevent it. The only supported
         * embed is their badge script, which is a third party connection from
         * every visitor and needs a CSP exception. It is available as a switch
         * in the admin; this card is what renders either way, from the record
         * already maintained on this site.
         */
      %>
      <% if (settings.linkedin_badge) { %>
        <div class="badge-base LI-profile-badge" data-locale="en_US" data-size="medium"
             data-theme="light" data-type="VERTICAL" data-vanity="<%= linkedin.handle %>"
             data-version="v1" style="margin-bottom: var(--s-3);">
          <a class="badge-base__link LI-simple-link" href="<%= linkedin.url %>" rel="noopener">
            View the Full Profile on LinkedIn
          </a>
        </div>
        <script src="https://platform.linkedin.com/badges/js/profile.js" async defer type="text/javascript"></script>
      <% } %>

      <div class="titleblock" style="margin-bottom: var(--s-4);">
        <% for (const s of schools.slice(0, 2)) { %>
          <div><span class="k"><%= s.kind === 'high-school' ? 'School' : 'University' %></span><span class="v"><%= s.name %></span></div>
          <% if (s.credential) { %>
            <div><span class="k">Credential</span><span class="v"><%= s.credential %></span></div>
          <% } %>
        <% } %>
        <div><span class="k">Based</span><span class="v">Half Moon Bay, CA</span></div>
        <div><span class="k">Seeking</span><span class="v">Summer 2027 Internship</span></div>
      </div>

      <div class="btn-row">
        <a class="btn" href="<%= linkedin.url %>" rel="me noopener">Open LinkedIn</a>
        <a class="btn btn-quiet" href="/resume">Read the Resume</a>
      </div>
    </section>
  </div>

  <%# ---------------------------------------------------------- repositories %>
  <% if (gh.top.length) { %>
    <section class="section">
      <p class="eyebrow">Repositories</p>
      <h2>Most Recent Work on GitHub</h2>
      <p class="measure" style="color: var(--text-muted); font-size:.95rem;">
        Ranked by stars, then by the most recent push. Forks and archived
        repositories sink rather than disappear.
      </p>

      <div class="repo-list" style="margin-top: var(--s-4);">
        <% for (const r of gh.top) { %>
          <a class="repo" href="<%= r.url %>" rel="noopener">
            <span class="repo-name"><%= r.name %></span>
            <% if (r.description) { %><p class="repo-desc"><%= r.description %></p><% } %>
            <span class="repo-meta">
              <% if (r.language) { %>
                <span><span class="repo-lang-dot" aria-hidden="true"></span><%= r.language %></span>
              <% } %>
              <% if (r.stars) { %><span class="tnum"><%= r.stars %> star<%= r.stars === 1 ? '' : 's' %></span><% } %>
              <% if (r.forks) { %><span class="tnum"><%= r.forks %> fork<%= r.forks === 1 ? '' : 's' %></span><% } %>
              <% if (r.pushedAt) { %><span>Pushed <%= r.pushedAt.slice(0, 10) %></span><% } %>
              <% if (r.fork) { %><span class="badge">Fork</span><% } %>
              <% if (r.archived) { %><span class="badge">Archived</span><% } %>
            </span>
          </a>
        <% } %>
      </div>

      <p style="margin-top: var(--s-4);">
        <a href="https://github.com/<%= gh.username %>?tab=repositories" rel="noopener">
          All <%= gh.profile ? gh.profile.publicRepos : gh.repos.length %> repositories on GitHub
        </a>
      </p>

      <p class="eyebrow" style="margin-top: var(--s-4);">
        <% if (gh.fetchedAt) { %>
          Fetched <time datetime="<%= gh.fetchedAt %>"><%= gh.fetchedAt.slice(0, 16).replace('T', ' ') %></time> UTC<%
            if (gh.refreshing) { %> &middot; refreshing<% } %>
        <% } %>
      </p>
    </section>
  <% } %>

  <%# --------------------------------------------------------------- contact %>
  <section class="section" id="contact">
    <p class="eyebrow">Contact</p>
    <h2>Get in Touch</h2>
    <% if (sent) { %>
      <p class="lede measure" style="color: var(--text-muted); margin-top: var(--s-3);">
        That reached me. I read everything and reply to anything that is not automated.
      </p>
    <% } else { %>
      <p class="measure" style="color: var(--text-muted);">
        This goes straight to my inbox and is kept here as well, so a mail
        problem never loses a message.
      </p>
      <div style="max-width: 46rem;">
        <%- include('../partials/contact-form', { formId: 'pro', stamp, errors, values }) %>
      </div>
    <% } %>
  </section>
</section>
