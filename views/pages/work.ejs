<section class="wrap" style="padding-top: var(--s-6);">
  <p class="eyebrow">Work</p>
  <h1>Everything, filterable</h1>
  <p class="prose lede" style="color: var(--text-muted);">
    Selecting a discipline emphasises the work where it applies and de-emphasises the rest.
    Nothing is hidden, so the breadth stays visible and the page does not jump.
  </p>

  <div class="chips" style="margin-top: var(--s-4);">
    <a class="chip" href="/work" aria-pressed="<%= active ? 'false' : 'true' %>">All<span class="tnum" style="color: var(--text-muted);"><%= projects.length %></span></a>
    <% for (const d of disciplines) { %>
      <a class="chip" href="/work?d=<%= d.slug %>" aria-pressed="<%= active === d.slug ? 'true' : 'false' %>">
        <span class="dot" style="background: var(--<%= d.color_token %>);"></span>
        <%= d.label %>
        <% if (counts[d.slug]) { %><span class="tnum" style="color: var(--text-muted);"><%= counts[d.slug] %></span><% } %>
      </a>
    <% } %>
  </div>

  <p class="eyebrow" role="status" style="margin-top: var(--s-4);">
    <% if (active) { %><%= matchCount %> of <%= projects.length %> match<% } else { %><%= projects.length %> projects<% } %>
  </p>

  <div class="grid"<%= active ? ' data-filtering' : '' %>>
    <% for (const p of projects) { %><%- include('../partials/card', { p }) %><% } %>
  </div>
</section>
