<section class="wrap pad-top">
  <p class="eyebrow"><%= c('work.eyebrow') %></p>
  <h1><%= c('work.heading') %></h1>
  <p class="prose lede" style="color: var(--text-muted);">
    <%= c('work.lede') %>
  </p>

  <div class="chips" style="margin-top: var(--s-4);">
    <a class="chip" href="/work"<%- active ? '' : ' aria-current="true"' %>><%= c('work.chip.all') %><span class="tnum" style="color: var(--text-muted);"><%= projects.length %></span></a>
    <% for (const d of disciplines) { %>
      <a class="chip" href="/work?d=<%= d.slug %>"<%- active === d.slug ? ' aria-current="true"' : '' %>>
        <span class="dot" style="background: var(--<%= d.color_token %>);"></span>
        <%= d.label %>
        <% if (counts[d.slug]) { %><span class="tnum" style="color: var(--text-muted);"><%= counts[d.slug] %></span><% } %>
      </a>
    <% } %>
  </div>

  <p class="eyebrow" role="status" style="margin-top: var(--s-4);">
    <% if (active) { %><%= matchCount %> <%= c('work.status.of') %> <%= projects.length %> <%= c('work.status.match') %><% } else { %><%= projects.length %> <%= c('work.status.projects') %><% } %>
  </p>

  <div class="grid"<%- active ? ' data-filtering' : '' %>>
    <% for (const p of projects) { %><%- include('../partials/card', { p }) %><% } %>
  </div>
</section>
