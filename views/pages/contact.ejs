<%
  /* The narrow measure goes on an inner column, not on .wrap. Capping .wrap
     itself also re-centres it, because .wrap carries margin-inline:auto: the
     whole page then sat 220px to the right of every other page on the site,
     so navigating from search to contact shifted the column sideways. */
%>
<section class="wrap pad-top">
 <div style="max-width: 46rem;">
  <p class="eyebrow">Contact</p>

  <% if (sent) { %>
    <h1>Message Sent</h1>
    <p class="lede" style="color: var(--text-muted); margin-top: var(--s-3);">
      That reached me. I read everything and reply to anything that is not automated.
    </p>
    <p style="margin-top: var(--s-4);">
      <a href="/work">Back to the Work</a> &middot; <a href="/">Home</a>
    </p>

  <% } else { %>
    <h1>Get in Touch</h1>
    <p class="lede prose" style="color: var(--text-muted); margin-top: var(--s-3);">
      Available for summer 2027 internships in mechanical design, controls, electrical or
      embedded work, in the Bay Area or Los Angeles. Also happy to talk about FIRST, or
      about anything on this site.
    </p>

    <%- include('../partials/contact-form', { formId: 'main', stamp, errors, values }) %>

    <p style="margin-top: var(--s-5); color: var(--text-muted); font-size:.92rem;">
      There is no tracking on this form, no third party script and no captcha.
      It is checked on the server instead. If you would rather not use a form,
      <a href="https://linkedin.com/in/edean07" rel="me noopener">LinkedIn</a> works too.
    </p>
  <% } %>
 </div>
</section>
