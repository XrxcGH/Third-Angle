<section class="wrap pad-top">
  <p class="eyebrow"><%= c('education.eyebrow') %></p>
  <h1><%= c('education.heading') %></h1>
  <p class="lede prose" style="color: var(--text-muted);">
    <%= c('education.lede') %>
  </p>

  <% if (totals.total) { %>
    <div class="metrics" style="margin-top: var(--s-5);">
      <div class="metric">
        <div class="metric-value tnum"><%= totals.completed %></div>
        <div class="metric-label"><%= c('education.metric.completed') %></div>
      </div>
      <div class="metric">
        <div class="metric-value tnum"><%= totals['in-progress'] %></div>
        <div class="metric-label"><%= c('education.metric.progress') %></div>
      </div>
      <% if (totals.planned) { %>
        <div class="metric">
          <div class="metric-value tnum"><%= totals.planned %></div>
          <div class="metric-label"><%= c('education.metric.planned') %></div>
        </div>
      <% } %>
      <div class="metric">
        <div class="metric-value tnum"><%= schools.length %></div>
        <div class="metric-label"><%= c('education.metric.schools') %></div>
      </div>
    </div>
  <% } %>

  <% if (!schools.length) { %>
    <p style="color: var(--text-muted); margin-top: var(--s-5);">
      <%= c('education.empty') %>
    </p>
  <% } %>

  <% for (const s of schools) { %>
    <section class="section" id="<%= s.slug %>">
      <p class="eyebrow">
        <%= label('schoolKind', s.kind) %>
      </p>
      <h2><%= s.name %></h2>

      <%
        /*
         * Facts across the page, not a narrow two column box in the left half
         * of the screen. Each is a label and a value at reading size, wrapping
         * to as many columns as the window has room for.
         */
        const facts = [
          [c('education.tb.credential'), s.credential],
          [c('education.tb.location'), s.location],
          [c('education.tb.dates'), (s.started_on || '') + (s.ended_on ? ' to ' + s.ended_on : '')],
          [c('education.tb.honours'), s.honours],
          [c('education.tb.classes'), s.counts.total
            ? s.counts.completed + ' ' + c('education.done')
              + (s.counts['in-progress'] ? ', ' + s.counts['in-progress'] + ' ' + c('education.inprogress') : '')
            : ''],
        ].filter(([, v]) => v && String(v).trim());
      %>
      <dl class="facts">
        <% for (const [k, v] of facts) { %>
          <div>
            <dt><%= k %></dt>
            <dd><%= v %></dd>
          </div>
        <% } %>
      </dl>

      <% if (s.blurb) { %>
        <p class="measure" style="margin-top: var(--s-4);"><%= s.blurb %></p>
      <% } %>

      <%# ---------------------------------------------------------- coursework %>
      <%
        /* Grouped by status, not by term. "Completed" and "in progress" are
           different claims about the same subject, and one merged list makes
           the stronger one on the reader's behalf. The term is shown per row
           wherever it has been recorded. */
        const STATUS_LABEL = (v) => label('courseStatus', v);
      %>
      <% if (s.groups.length) { %>
        <div class="section-head">
          <h3><%= c('education.coursework') %></h3>
          <%
            /* A real form with a submit, because there is no JavaScript on this
               site. The anchor takes the reader back to the school they were
               reading rather than to the top of the page. */
          %>
          <form class="sortbar" method="get" action="/education#<%= s.slug %>">
            <label for="sort-<%= s.slug %>"><%= c('education.sort.label') %></label>
            <select id="sort-<%= s.slug %>" name="sort">
              <option value="term"<%= sort === 'term' ? ' selected' : '' %>><%= c('education.sort.term') %></option>
              <option value="name"<%= sort === 'name' ? ' selected' : '' %>><%= c('education.sort.name') %></option>
            </select>
            <button class="btn btn-quiet btn-sm" type="submit"><%= c('education.sort.apply') %></button>
          </form>
        </div>
        <% for (const g of s.groups) { %>
          <div class="term-block">
            <p class="eyebrow">
              <%= STATUS_LABEL(g.status) %>
              <span class="tnum">&middot; <%= g.courses.length %></span>
            </p>
            <div class="course-list">
              <% for (const c of g.courses) { %>
                <div class="course">
                  <span class="course-code"><%= c.code || '' %></span>
                  <span>
                    <span class="course-title"><%= c.title %></span>
                    <% if (c.note) { %><span class="course-note"><%= c.note %></span><% } %>
                  </span>
                  <%
                    /* Units and term in one run, separated, because "5.0 Fall
                       2026" set in the same mono face at the same size reads as
                       a single string and the number looks like part of the
                       date. The unit noun is what tells them apart. */
                  %>
                  <span class="course-meta mono">
                    <% if (c.units) { %>
                      <span class="tnum"><%= c.units %></span> <%= locals.c('education.units.noun') %><% if (c.term) { %> &middot;<% } %>
                    <% } %>
                    <% if (c.term) { %><%= c.term %><% } %>
                  </span>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>
      <% } %>

      <%# ---------------------------------------------------------- activities %>
      <%
        const acts = s.activities.filter((a) => a.kind === 'activity');
        const awards = s.activities.filter((a) => a.kind !== 'activity');
      %>
      <% if (acts.length) { %>
        <h3 style="margin-top: var(--s-5);"><%= c('education.activities') %></h3>
        <%
          /* A grid, not a two column list. The old layout gave every name a
             narrow left column, so "California Scholarship Federation" broke
             over three lines while the right half of the window sat empty. */
        %>
        <div class="entry-grid">
          <% for (const a of acts) { %>
            <div class="entry">
              <div>
                <span class="entry-title"><%= a.title %></span>
                <% if (a.role) { %>
                  <span class="eyebrow" style="margin:0; display:block;"><%= a.role %></span>
                <% } %>
              </div>
              <p style="margin:0;">
                <%= a.detail || '' %>
                <% if (a.started_on || a.ended_on) { %>
                  <span class="mono" style="font-size:.66rem; color: var(--text-muted); white-space:nowrap;">
                    <%= a.started_on || '' %><% if (a.ended_on) { %> to <%= a.ended_on %><% } %>
                  </span>
                <% } %>
              </p>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (awards.length) { %>
        <h3 style="margin-top: var(--s-5);"><%= c('education.awards') %></h3>
        <ul class="stack measure" style="margin-top: var(--s-3); padding-left: 1.2rem;">
          <% for (const a of awards) { %>
            <li>
              <strong><%= a.title %></strong><% if (a.detail) { %>. <%= a.detail %><% } %>
              <% if (a.ended_on || a.started_on) { %>
                <span class="mono" style="font-size:.66rem; color: var(--text-muted);"><%= a.ended_on || a.started_on %></span>
              <% } %>
            </li>
          <% } %>
        </ul>
      <% } %>
    </section>
  <% } %>

  <%# -------------------------------------------------- everything unattached %>
  <%
    /* Everything that belongs to no institution. Split by kind, because a
       mentorship somebody is still doing and a medal from 2023 are different
       claims: one is a commitment, the other is a result, and a single bullet
       list makes them look like the same thing. */
    const loose = unattached.filter((a) => a.kind === 'activity');
    const looseAwards = unattached.filter((a) => a.kind !== 'activity');
  %>
  <% if (unattached.length) { %>
    <section class="section">
      <p class="eyebrow"><%= c('education.unattached.eyebrow') %></p>

      <% if (loose.length) { %>
        <h2><%= c('education.unattached.heading') %></h2>
        <div class="entry-grid">
          <% for (const a of loose) { %>
            <div class="entry">
              <div>
                <span class="entry-title"><%= a.title %></span>
                <% if (a.role) { %>
                  <span class="eyebrow" style="margin:0; display:block;"><%= a.role %></span>
                <% } %>
              </div>
              <p style="margin:0;">
                <%= a.detail || '' %>
                <% if (a.started_on || a.ended_on) { %>
                  <span class="mono" style="font-size:.66rem; color: var(--text-muted); white-space:nowrap;">
                    <%= a.started_on || '' %><% if (a.ended_on && a.ended_on !== a.started_on) { %> to <%= a.ended_on %><% } %>
                  </span>
                <% } %>
              </p>
            </div>
          <% } %>
        </div>
      <% } %>

      <% if (looseAwards.length) { %>
        <h3 style="margin-top: var(--s-5);"><%= c('education.unattached.awards') %></h3>
        <ul class="stack measure" style="margin-top: var(--s-3); padding-left: 1.2rem;">
          <% for (const a of looseAwards) { %>
            <li>
              <strong><%= a.title %></strong><% if (a.detail) { %>. <%= a.detail %><% } %>
              <% if (a.ended_on || a.started_on) { %>
                <span class="mono" style="font-size:.66rem; color: var(--text-muted);"><%= a.ended_on || a.started_on %></span>
              <% } %>
            </li>
          <% } %>
        </ul>
      <% } %>
    </section>
  <% } %>

  <nav class="btn-row" style="margin-top: var(--s-7);">
    <a class="btn btn-quiet" href="/documents"><%= c('education.cta.resume') %></a>
    <a class="btn btn-quiet" href="/work"><%= c('education.cta.work') %></a>
  </nav>
</section>
