<section class="wrap hero">
  <div>
    <p class="eyebrow">Mechanical &middot; Electrical &middot; Controls &middot; Software</p>
    <h1 class="display-1">I build the machine, wire it, write the code that runs it, and the document that explains it.</h1>
    <p class="lede">
      Mechanical engineering at UCLA. Four seasons of FIRST Robotics Competition, first as a founding
      team captain and now as a mentor. Currently interning at the Western Region Robotics Forum and
      founding Groundwork Robotics.
    </p>
  </div>

  <div class="titleblock">
    <div><span class="k">Discipline</span><span class="v">Mechanical Engineering</span></div>
    <div><span class="k">School</span><span class="v">UCLA, BS 2029</span></div>
    <div><span class="k">Based</span><span class="v">Half Moon Bay, CA</span></div>
    <div><span class="k">Seeking</span><span class="v">Summer 2027 internship</span></div>
    <div><span class="k">Code</span><span class="v">github.com/XrxcGH</span></div>
  </div>
</section>

<section class="wrap section">
  <p class="eyebrow">Disciplines</p>
  <h2>One record, several projections</h2>
  <p class="prose">
    A competition robot is mechanical and electrical and controls and software at the same time.
    Rather than splitting one project across several pages, each carries weighted disciplines and
    opens with a different sentence depending on which door you came through.
  </p>
  <div class="chips" style="margin-top: var(--s-4);">
    <% for (const d of disciplines) { %>
      <a class="chip icon-host" href="/work?d=<%= d.slug %>">
        <span style="color: var(--<%= d.color_token %>); display:flex;"><%- include('../partials/icon', { name: d.slug, size: 16 }) %></span>
        <%= d.label %>
        <% if (counts[d.slug]) { %><span class="tnum" style="color: var(--text-muted);"><%= counts[d.slug] %></span><% } %>
      </a>
    <% } %>
  </div>
</section>

<section class="wrap section">
  <p class="eyebrow">Selected work</p>
  <h2>Work</h2>
  <div class="grid" style="margin-top: var(--s-4);">
    <% for (const p of projects.slice(0, 6)) { %><%- include('../partials/card', { p }) %><% } %>
  </div>
  <p style="margin-top: var(--s-4);"><a href="/work">All work</a></p>
</section>

<% if (now && now.body_html) { %>
<section class="wrap section">
  <p class="eyebrow">Now</p>
  <div class="prose rail"><%- now.body_html %></div>
</section>
<% } %>
