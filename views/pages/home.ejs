<section class="wrap hero">
  <%
    /* Three children, not two. The headline spans the full width and the lede
       and the title block share the row underneath it. As two columns the
       headline was confined to the left 1.35fr and ran to five lines, while
       the column beside it stayed empty down to the title block. */
  %>
  <div class="hero-head">
    <p class="eyebrow"><%= c('home.eyebrow') %></p>
    <h1 class="display-1"><%= c('home.headline') %></h1>
  </div>

  <p class="lede"><%= c('home.lede') %></p>

  <%
    /* Five rows, every one of them editable, key and value. A titleblock is a
       drawing convention: it says what the thing is before you read it, so it
       has to be able to say something different when the answer changes. */
  %>
  <div class="titleblock">
    <% for (const n of [1, 2, 3, 4, 5]) { %>
      <% if (c(`home.tb${n}.k`) || c(`home.tb${n}.v`)) { %>
        <div><span class="k"><%= c(`home.tb${n}.k`) %></span><span class="v"><%= c(`home.tb${n}.v`) %></span></div>
      <% } %>
    <% } %>
  </div>
</section>

<section class="wrap section<%= cf('home.disciplines.rule') ? '' : ' no-rule' %>">
  <p class="eyebrow"><%= c('home.disciplines.eyebrow') %></p>
  <h2><%= c('home.disciplines.heading') %></h2>
  <div class="prose"><%- cr('home.disciplines.body') %></div>
  <div class="chips" style="margin-top: var(--s-4);">
    <% for (const d of disciplines) { %>
      <a class="chip icon-host" href="/work?d=<%= d.slug %>">
        <span style="color: var(--<%= d.color_token %>); display:flex;"><%- include('../partials/icon', { name: d.slug, size: 16 }) %></span>
        <%= d.label %>
        <% if (counts[d.slug]) { %><span class="tnum" style="color: var(--text-muted);"><%= counts[d.slug] %></span><% } %>
      </a>
    <% } %>
  </div>
</section>

<section class="wrap section<%= cf('home.work.rule') ? '' : ' no-rule' %>">
  <p class="eyebrow"><%= c('home.work.eyebrow') %></p>
  <h2><%= c('home.work.heading') %></h2>
  <div class="grid" style="margin-top: var(--s-4);">
    <% for (const p of projects.slice(0, 6)) { %><%- include('../partials/card', { p }) %><% } %>
  </div>
  <p style="margin-top: var(--s-4);"><a href="/work"><%= c('home.work.link') %></a></p>
</section>

<% if (now && now.body_html) { %>
<section class="wrap section<%= cf('home.now.rule') ? '' : ' no-rule' %>">
  <p class="eyebrow"><%= c('home.now.eyebrow') %></p>
  <div class="prose rail"><%- now.body_html %></div>
</section>
<% } %>
