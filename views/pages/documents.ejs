<section class="wrap" style="padding-top: var(--s-6);">
  <p class="eyebrow">Documents</p>
  <h1>Written to be used without me in the room</h1>
  <p class="lede prose" style="color: var(--text-muted);">
    Game manuals, migration runbooks, governance packages and training curricula.
    Every page of every document is indexed, so a search for a term returns the
    document and the page it is on.
  </p>

  <% if (!docs.length) { %>
    <p style="color: var(--text-muted); margin-top: var(--s-5);">Nothing published here yet.</p>
  <% } else { %>
    <div class="doc-grid" style="margin-top: var(--s-5);">
      <% for (const d of docs) { %>
        <a class="doc-card" href="/documents/<%= d.slug %>">
          <span class="doc-spine" aria-hidden="true"></span>
          <span class="doc-body">
            <span class="card-meta">
              <span class="badge"><%= d.pages %> page<%= d.pages === 1 ? '' : 's' %></span>
              <% if (d.project_title) { %><span><%= d.project_title %></span><% } %>
            </span>
            <span class="card-title"><%= d.title %></span>
            <% if (d.description) { %><span class="card-summary"><%= d.description %></span><% } %>
            <span class="mono" style="font-size:.6rem; letter-spacing:.1em; color: var(--text-muted);">
              PDF &middot; <%= (d.bytes / 1024 / 1024).toFixed(1) %> MB
            </span>
          </span>
        </a>
      <% } %>
    </div>
  <% } %>
</section>
