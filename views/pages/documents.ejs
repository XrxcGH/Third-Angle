<section class="wrap pad-top">
  <p class="eyebrow"><%= c('documents.eyebrow') %></p>
  <h1><%= c('documents.heading') %></h1>
  <p class="lede prose" style="color: var(--text-muted);">
    <%= c('documents.lede') %>
  </p>

  <%# ------------------------------------------------------- resume and CV %>
  <% if (pinned.length) { %>
    <% for (const d of pinned) { %>
      <section class="section" id="<%= d.slug %>">
        <p class="eyebrow"><%= d.doc_role === 'cv' ? c('documents.cv.label') : c('documents.resume.label') %></p>
        <h2><%= d.title %></h2>
        <% if (d.description) { %>
          <p class="measure" style="color: var(--text-muted);"><%= d.description %></p>
        <% } %>

        <div class="btn-row" style="margin-top: var(--s-3);">
          <a class="btn" href="/documents/<%= d.slug %>/view" target="_blank" rel="noopener"><%= c('documents.cta.open') %></a>
          <a class="btn btn-quiet" href="/documents/<%= d.slug %>/download"><%= c('documents.cta.download') %></a>
          <a class="btn btn-quiet" href="/documents/<%= d.slug %>"><%= c('documents.cta.search') %></a>
        </div>

        <% if (pdfViewer) { %>
          <%
            /*
             * <object>, not <iframe>.
             *
             * An object falls back to its own children when the browser has no
             * PDF plugin, which is most mobile browsers. An iframe renders an
             * empty grey box instead, with nothing to tell the reader what
             * happened or what to do about it.
             *
             * The PDF response carries its own Content-Security-Policy of
             * default-src 'none'; sandbox, so a PDF that contains script has no
             * origin to reach and nothing to load. See the /documents/:slug/view
             * route.
             */
          %>
          <object class="pdf-frame" data="/documents/<%= d.slug %>/view" type="application/pdf"
                  aria-label="<%= d.title %>, <%= c('documents.pdf.aria') %>" style="margin-top: var(--s-4);">
            <div class="pdf-fallback">
              <p><%= c('documents.pdf.fallback') %></p>
              <p class="btn-row" style="justify-content:center;">
                <a class="btn" href="/documents/<%= d.slug %>/view" target="_blank" rel="noopener"><%= c('documents.cta.open') %></a>
                <a class="btn btn-quiet" href="/documents/<%= d.slug %>/download"><%= c('documents.cta.download') %></a>
              </p>
            </div>
          </object>
          <p class="pdf-note" style="margin-top: var(--s-3);">
            <%= c('documents.pdf.note') %>
          </p>
          <p class="eyebrow" style="margin-top: var(--s-2);">
            <%= d.pages %> <%= c('document.page.noun') %><%= d.pages === 1 ? '' : 's' %> &middot;
            <%= fmtBytes(d.bytes) %> &middot;
            <%= c('site.updated') %> <%= d.updated_at.slice(0, 10) %>
          </p>
        <% } %>
      </section>
    <% } %>
  <% } %>

  <%# ------------------------------------------------------------- library %>
  <section class="section">
    <p class="eyebrow"><%= c('documents.library.eyebrow') %></p>
    <h2><%= others.length %> <%= c('documents.library.noun') %><%= others.length === 1 ? '' : 's' %></h2>

    <% if (!others.length) { %>
      <p style="color: var(--text-muted); margin-top: var(--s-3);">
        <% if (pinned.length) { %>
          <%= c('documents.empty.some') %>
        <% } else { %>
          <%= c('documents.empty.none') %>
        <% } %>
      </p>
    <% } else { %>
      <div style="margin-top: var(--s-3);">
        <% for (const d of others) { %>
          <article class="doc-row">
            <div>
              <h3><a href="/documents/<%= d.slug %>"><%= d.title %></a></h3>
              <% if (d.description) { %><p class="doc-desc"><%= d.description %></p><% } %>
              <p class="card-meta" style="margin-top: var(--s-2);">
                <span class="badge"><%= d.pages %> <%= c('document.page.noun') %><%= d.pages === 1 ? '' : 's' %></span>
                <span><%= fmtBytes(d.bytes) %></span>
                <% if (d.project_title) { %><span><%= d.project_title %></span><% } %>
                <% if (d.indexed_pages < d.pages) { %>
                  <span><%= d.indexed_pages %> / <%= d.pages %> <%= c('documents.indexed') %></span>
                <% } %>
              </p>
            </div>
            <div class="btn-row" style="justify-content: flex-end;">
              <a class="btn btn-quiet btn-sm" href="/documents/<%= d.slug %>/view" target="_blank" rel="noopener"><%= c('documents.row.view') %></a>
              <a class="btn btn-quiet btn-sm" href="/documents/<%= d.slug %>/download"><%= c('documents.row.download') %></a>
            </div>
          </article>
        <% } %>
      </div>
    <% } %>
  </section>
</section>
