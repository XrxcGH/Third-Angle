<section class="wrap pad-top">
  <p class="eyebrow"><%= c('disciplines.eyebrow') %></p>
  <h1><%= c('disciplines.heading') %></h1>
  <p class="prose lede" style="color: var(--text-muted);">
    <%= c('disciplines.lede') %>
  </p>

  <div class="stack" style="margin-top: var(--s-5);">
    <% for (const d of disciplines) { %>
      <a class="icon-host facet-row-link" href="/disciplines/<%= d.slug %>"
         style="display:grid; grid-template-columns: 28px minmax(0,1fr) auto; gap: var(--s-4); align-items: start; padding-block: var(--s-4); border-bottom: 1px solid var(--hairline);">
        <span style="color: var(--<%= d.color_token %>); margin-top:3px;"><%- include('../partials/icon', { name: d.slug, size: 26 }) %></span>
        <span class="facet-text">
          <span class="facet-label"><%= d.label %></span>
          <% if (d.blurb) { %><span class="facet-blurb"><%= d.blurb %></span><% } %>
        </span>
        <span class="mono tnum" style="font-size:.7rem; color: var(--text-muted);"><%= counts[d.slug] || 0 %></span>
      </a>
    <% } %>
  </div>
</section>
