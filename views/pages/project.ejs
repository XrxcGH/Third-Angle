<%
  /*
   * Tier decides how many blocks render. R8: hollow sections come from a
   * template asking for them, so a note is never offered twelve slots to pad.
   *   note       header, hero evidence, summary
   *   build      adds metrics, discipline breakdown, links
   *   case-study everything
   *
   * has() renders a section or renders ABSOLUTELY NOTHING. No heading, no empty
   * card, no "coming soon". The rule lives in one place so it cannot drift.
   */
  const TIERS = { note: 3, build: 6, 'case-study': 12 };
  const depth = TIERS[project.tier] || 3;
  const has = (content, min) => {
    if (Array.isArray(content)) return content.length > 0;
    const s = String(content || '').replace(/<[^>]*>/g, '').trim();
    return s.length >= (min || 1);
  };
  const media = project.media || [];
  const hero = media[0];
  const rest = media.slice(1);
%>

<article class="wrap pad-top">

  <p class="eyebrow">
    <%= project.context || 'Project' %><% if (project.role) { %> &middot; <%= project.role %><% } %><% if (project.started_on) { %> &middot; <%= project.started_on %><% if (project.ended_on) { %> to <%= project.ended_on %><% } %><% } %>
  </p>
  <h1><%= project.title %></h1>
  <% if (project.subtitle) { %>
    <p class="lede prose" style="color: var(--text-muted); margin-top: var(--s-3);"><%= project.subtitle %></p>
  <% } %>

  <div class="chips" style="margin-top: var(--s-4);">
    <span class="badge" data-status="<%= project.status %>"><%= label('status', project.status) %></span>
    <% for (const f of project.facets) { %>
      <a class="chip" href="/disciplines/<%= f.slug %>">
        <span class="dot" style="background: var(--<%= f.color_token %>);"></span><%= f.label %>
      </a>
    <% } %>
  </div>

  <% if (hero) { %>
    <%# A working image or clip outranks every other evidence type, so it sits
        above the prose rather than in a gallery at the bottom. %>
    <div style="margin-top: var(--s-5);">
      <%- include('../partials/figure', { m: hero, slot: '(min-width: 900px) 1100px, 100vw', priority: true }) %>
    </div>
  <% } %>

  <% if (depth >= 6 && has(project.metrics)) { %>
    <div class="metrics" style="margin-top: var(--s-5);">
      <% for (const mt of project.metrics) { %>
        <div class="metric">
          <div class="metric-value"><%= mt.value %><% if (mt.unit) { %><span style="font-size:.6em; color: var(--text-muted);"> <%= mt.unit %></span><% } %></div>
          <div class="metric-label"><%= mt.label %></div>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (has(project.summary_html, 40)) { %>
    <section class="section prose"><%- project.summary_html %></section>
  <% } %>

  <%
    /* The answer to how one record serves eight audiences: same page, a
       different opening sentence depending on which door you came through. */
    const noted = project.facets.filter((f) => has(f.contribution_note, 10));
  %>
  <% if (depth >= 6 && noted.length) { %>
    <section class="section">
      <p class="eyebrow"><%= c('project.breakdown.eyebrow') %></p>
      <h2><%= c('project.breakdown.heading') %></h2>
      <div class="stack" style="margin-top: var(--s-4);">
        <% for (const f of noted) { %>
          <div class="discipline-row">
            <%
              /* The weight goes on its own line rather than after a middot.
                 A long label such as "Mechanical and CAD" wraps inside the
                 11rem column, which left the separator stranded at the end of
                 the first line with the weight orphaned underneath it. */
            %>
            <div class="eyebrow" style="margin:0; color: var(--<%= f.color_token %>);">
              <%= f.label %>
              <span style="color: var(--text-muted); display:block;"><%= label('weight', f.weight) %></span>
            </div>
            <p style="margin:0;"><%= f.contribution_note %></p>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (has(project.body_html, 80)) { %>
    <section class="section prose"><%- project.body_html %></section>
  <% } %>

  <% if (rest.length) { %>
    <section class="section">
      <p class="eyebrow"><%= c('project.evidence.eyebrow') %></p>
      <h2><%= media.length %> <%= c('project.evidence.noun') %><%= media.length === 1 ? '' : 's' %></h2>
      <div class="figure-grid" style="margin-top: var(--s-4);">
        <% for (const mm of rest) { %>
          <%- include('../partials/figure', { m: mm, slot: '(min-width: 900px) 520px, 100vw' }) %>
        <% } %>
      </div>
    </section>
  <% } %>

  <% if (depth >= 6 && has(project.links)) { %>
    <section class="section">
      <p class="eyebrow"><%= c('project.links.eyebrow') %></p>
      <ul class="stack" style="list-style:none; padding:0; margin-top: var(--s-3);">
        <% for (const l of project.links) { %>
          <li style="display:flex; gap: var(--s-3); align-items:baseline;">
            <span class="mono" style="font-size:.6rem; letter-spacing:.12em; text-transform:uppercase; color: var(--text-muted); min-width:5.5rem;"><%= label('linkKind', l.kind) %></span>
            <a href="<%= l.url %>" rel="noopener"><%= l.label %></a>
          </li>
        <% } %>
      </ul>
    </section>
  <% } %>

  <nav style="margin-top: var(--s-7); display:flex; gap: var(--s-4); flex-wrap:wrap;">
    <a href="/work"><%= c('project.back') %></a>
    <% if (project.facets[0]) { %>
      <%
        /* Not toLowerCase(). The labels carry acronyms, and lower-casing
           "Mechanical and CAD" produced "More mechanical and cad". */
      %>
      <a href="/disciplines/<%= project.facets[0].slug %>"><%= c('project.more') %> <%= project.facets[0].label %></a>
    <% } %>
  </nav>
</article>
