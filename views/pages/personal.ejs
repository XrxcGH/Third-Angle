<section class="wrap pad-top">
  <p class="eyebrow"><%= c('personal.eyebrow') %></p>
  <h1><%= c('personal.heading') %></h1>
  <p class="lede prose" style="color: var(--text-muted);">
    <%= c('personal.lede') %>
  </p>
</section>

<% if (!count) { %>
  <section class="wrap">
    <p style="color: var(--text-muted); margin-top: var(--s-5);">
      <%= c('personal.empty') %>
    </p>
  </section>
<% } else { %>

  <%
    /*
     * The wall.
     *
     * Outside .wrap on purpose, so it runs the full width of the window rather
     * than stopping at the 1180px measure the reading pages use. Photographs
     * are not prose and do not want a measure.
     *
     * Nothing here decides a position. Each tile carries only its aspect ratio
     * as --ar, and flexbox packs the rows: every tile in a row lands on the same
     * height, the row fills the width exactly, and adding a photograph re-packs
     * everything after it. That is why there is no ordering step and nothing to
     * redo after an upload. Order is newest capture first, from SQL.
     */
  %>
  <div class="collage collage-full" style="--row-h-base: <%= rowHeight %>px;">
    <% for (const t of tiles) { %>
      <figure class="collage-item" style="--ar: <%= t.aspect %>;" tabindex="0">
        <img src="/media/<%= t.storage_key %>"
             <% const wp = srcset(t, 'webp'); %>
             <% if (wp) { %>srcset="<%= wp %>" sizes="(min-width: 1400px) 25vw, (min-width: 700px) 40vw, 50vw"<% } %>
             alt="<%= t.alt %>"
             width="<%= t.width %>" height="<%= t.height %>"
             loading="lazy" decoding="async">
        <% if (t.caption) { %>
          <figcaption>
            <%= t.caption %><% if (t.capturedOn) { %>
              <span class="mono tnum" style="font-size:.62rem; opacity:.85;"><%= t.capturedOn %></span>
            <% } %>
          </figcaption>
        <% } %>
      </figure>
    <% } %>
  </div>

  <section class="wrap">
    <p class="eyebrow" style="margin-top: var(--s-5);">
      <%= count %> <%= c('personal.photograph.noun') %><%= count === 1 ? '' : 's' %>. <%= c('personal.footnote') %>
    </p>
  </section>
<% } %>
