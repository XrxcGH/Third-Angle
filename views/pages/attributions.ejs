<section class="wrap prose pad-top">
  <p class="eyebrow"><%= c('attributions.eyebrow') %></p>
  <h1><%= c('attributions.heading') %></h1>
  <p class="lede" style="color: var(--text-muted);">
    <%= c('attributions.lede') %>
  </p>

  <section class="section">
    <h2><%= c('attributions.fonts.heading') %></h2>
    <div class="prose"><%- cr('attributions.fonts.body') %></div>

    <div class="stack" style="margin-top: var(--s-4);">
      <% for (const f of fonts) { %>
        <div class="discipline-row">
          <div>
            <div style="font-family: var(--f-display); font-weight: var(--w-head); color: var(--text-strong);"><%= f.name %></div>
            <div class="mono" style="font-size:.62rem; letter-spacing:.1em; text-transform:uppercase; color: var(--text-muted);"><%= f.role %></div>
          </div>
          <div>
            <p style="margin:0 0 .3em;"><%= f.copyright %></p>
            <p style="margin:0; font-size:.9rem;">
              <a href="<%= f.url %>" rel="noopener"><%= c('attributions.fonts.source') %></a> &middot;
              <a href="/licenses/<%= f.file %>"><%= c('attributions.fonts.notice') %></a>
            </p>
          </div>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section">
    <h2><%= c('attributions.software.heading') %></h2>
    <div class="prose"><%- cr('attributions.software.body') %></div>
  </section>

  <section class="section">
    <h2><%= c('attributions.privacy.heading') %></h2>
    <div class="prose"><%- cr('attributions.privacy.body') %></div>
  </section>

  <section class="section">
    <h2><%= c('attributions.method.heading') %></h2>
    <div class="prose"><%- cr('attributions.method.body') %></div>
  </section>
</section>
