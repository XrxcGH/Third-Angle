<p class="eyebrow">Admin</p>
<h1>Build Log</h1>
<p style="color: var(--text-muted);">
  One field is required. This is the freshness mechanism: a site with no dated activity reads
  as abandoned, and an entry here costs thirty seconds. The public log hides itself entirely
  when it is empty rather than displaying a stale one.
</p>

<%
  /* One form, two jobs. `editing` is the row being corrected, if any: the same
     fields, prefilled, posting to the same route. */
  const e = (typeof editing !== 'undefined' && editing) ? editing : null;
%>
<form method="post" action="/admin/notes/save" class="panel" style="margin-top: var(--s-4);">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (e) { %><input type="hidden" name="id" value="<%= e.id %>"><% } %>
  <% if (e) { %>
    <p class="eyebrow" style="margin-top:0;">
      Editing the entry from <%= e.created_at.slice(0, 10) %>
      &middot; <a href="/admin/notes">start a new one instead</a>
    </p>
  <% } %>
  <div class="row2">
    <div class="field">
      <label for="title">Title, Optional</label>
      <input id="title" name="title" type="text" value="<%= e ? (e.title || '') : '' %>">
    </div>
    <div class="field">
      <label for="project_id">Related Project, Optional</label>
      <select id="project_id" name="project_id">
        <option value="">None</option>
        <% for (const p of projects) { %>
          <option value="<%= p.id %>"<%= e && e.project_id === p.id ? ' selected' : '' %>><%= p.title %></option>
        <% } %>
      </select>
    </div>
  </div>
  <div class="field field-full">
    <label for="body_md">What Happened</label>
    <textarea id="body_md" name="body_md" required><%= e ? e.body_md : '' %></textarea>
  </div>
  <label class="check" for="published">
    <input id="published" type="checkbox" name="published" value="1" <%= !e || e.published ? 'checked' : '' %>>
    <span>Published<span class="hint">An unpublished entry keeps its text and shows nobody.</span></span>
  </label>
  <button class="btn" type="submit"><%= e ? 'Save Changes' : 'Post Entry' %></button>
</form>

<div class="panel table-wrap" tabindex="0" role="region" aria-label="Table, scrolls sideways" style="padding:0; margin-top: var(--s-5);">
  <table class="admin-table">
    <thead>
      <tr><th style="width:7rem;">Date</th><th class="wide">Entry</th><th style="width:7rem;">State</th><th style="text-align:right; width:11rem;">Actions</th></tr>
    </thead>
    <tbody>
      <% if (!notes.length) { %>
        <tr><td colspan="4" style="color: var(--text-muted);">No entries yet.</td></tr>
      <% } %>
      <% for (const n of notes) { %>
        <tr>
          <td class="mono" style="font-size:.72rem; white-space:nowrap;"><%= n.created_at.slice(0, 10) %></td>
          <td class="wide">
            <% if (n.title) { %><strong><%= n.title %></strong><br><% } %>
            <span style="font-size:.88rem; color: var(--text-muted);"><%= n.body_md.slice(0, 180) %></span>
            <% if (n.updated_at && n.updated_at.slice(0, 16) !== n.created_at.slice(0, 16)) { %>
              <span class="eyebrow" style="margin:0; display:block;">Edited <%= n.updated_at.slice(0, 10) %></span>
            <% } %>
          </td>
          <td>
            <span class="badge" style="<%= n.published ? 'border-color: var(--patina); color: var(--patina);' : '' %>">
              <%= n.published ? 'Published' : 'Draft' %>
            </span>
          </td>
          <td>
            <div class="actions">
              <a class="btn btn-quiet btn-sm" href="/admin/notes?edit=<%= n.id %>#body_md">Edit</a>
              <form method="post" action="/admin/notes/<%= n.id %>/delete" style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrf %>">
                <button class="btn btn-danger btn-sm" type="submit">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
