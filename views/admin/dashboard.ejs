<p class="eyebrow">Admin</p>
<h1>Dashboard</h1>

<div class="stat-row" style="margin-top: var(--s-4);">
  <div class="stat"><b><%= counts.published %>/<%= counts.projects %></b><span>Published</span></div>
  <div class="stat"><b><%= counts.facets %></b><span>Disciplines</span></div>
  <div class="stat"><b><%= counts.media %></b><span>Media</span></div>
  <div class="stat"><b><%= counts.documents %></b><span>Documents</span></div>
  <div class="stat"><b><%= counts.pages %></b><span>Indexed Pages</span></div>
  <div class="stat"><b><%= counts.notes %></b><span>Log Entries</span></div>
  <div class="stat"><b><%= counts.messages %></b><span>Unread Messages</span></div>
  <div class="stat"><b><%= counts.undelivered %></b><span>Not Forwarded</span></div>
  <div class="stat"><b><%= counts.courses %></b><span>Classes</span></div>
  <div class="stat"><b><%= counts.photos %></b><span>Photos on Wall</span></div>
  <div class="stat"><b><%= counts.content %></b><span>Edited Strings</span></div>
  <div class="stat"><b><%= counts.errors %></b><span>New Errors</span></div>
</div>

<div class="btn-row" style="margin-top: var(--s-4);">
  <a class="btn" href="/admin/projects/new">New Project</a>
  <a class="btn btn-quiet" href="/admin/projects">Reorder Projects</a>
  <a class="btn btn-quiet" href="/admin/notes">Add a Log Entry</a>
  <a class="btn btn-quiet" href="/admin/education">Edit Education</a>
  <a class="btn btn-quiet" href="/admin/photos">Photo Wall</a>
  <a class="btn btn-quiet" href="/admin/content">Edit Page Content</a>
</div>

<section style="margin-top: var(--s-6);">
  <h2 style="font-size:1.2rem;">Recent Changes</h2>
  <div class="panel table-wrap" tabindex="0" role="region" aria-label="Table, scrolls sideways" style="margin-top: var(--s-3); padding: 0;">
    <table class="admin-table">
      <thead><tr><th>When</th><th>Who</th><th>What</th><th>Action</th></tr></thead>
      <tbody>
        <% if (!recent.length) { %>
          <tr><td colspan="4" style="color: var(--text-muted);">Nothing yet.</td></tr>
        <% } %>
        <% for (const r of recent) { %>
          <tr>
            <td class="mono" style="font-size:.72rem;"><%= r.at.slice(0,16).replace('T',' ') %></td>
            <td style="font-size:.85rem;"><%= r.actor || 'system' %></td>
            <td class="mono" style="font-size:.72rem;"><%= r.table_name %> #<%= r.row_id %></td>
            <td><span class="badge"><%= r.action %></span></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
