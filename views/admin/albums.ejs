<p class="eyebrow">Admin</p>
<h1>Photo Albums</h1>
<p class="measure" style="color: var(--text-muted);">
  An album is a folder, and the personal page renders whatever is in it right
  now. Putting a photograph in an album is what publishes it: there is no
  arranging step, because the collage packs itself from the shape of each
  photograph and re-packs when one is added.
</p>

<% if (saved) { %><p class="flash" role="status" style="margin-top: var(--s-4);">Saved.</p><% } %>

<%# ------------------------------------------------------------- the albums %>
<section style="margin-top: var(--s-5);">
  <h2><%= albums.length %> Album<%= albums.length === 1 ? '' : 's' %></h2>

  <% if (!albums.length) { %>
    <p style="color: var(--text-muted); margin-top: var(--s-3);">
      None yet. Create one below, then file photographs into it from the media
      page or from the unfiled list at the bottom of this page.
    </p>
  <% } %>

  <% for (const a of albums) { %>
    <div class="panel" style="margin-top: var(--s-3);">
      <div style="display:flex; gap: var(--s-3); align-items:baseline; flex-wrap:wrap;">
        <h3 style="margin:0;"><%= a.title %></h3>
        <% if (a.published) { %>
          <span class="badge" style="border-color: var(--patina); color: var(--patina);">Published</span>
        <% } else { %>
          <span class="badge">Hidden</span>
        <% } %>
        <span class="mono tnum" style="font-size:.7rem; color: var(--text-muted);">
          <%= a.photos.length %> photograph<%= a.photos.length === 1 ? '' : 's' %>
        </span>
        <a class="mono" style="font-size:.66rem; margin-left:auto;" href="/personal#<%= a.slug %>">/personal#<%= a.slug %></a>
      </div>

      <% if (a.blurb) { %>
        <p style="color: var(--text-muted); font-size:.9rem; margin: var(--s-2) 0 0;"><%= a.blurb %></p>
      <% } %>

      <% if (a.photos.length) { %>
        <%
          /* A contact sheet at a fixed size, deliberately not the public
             collage. This view is for identifying a photograph and taking it
             out again, and a justified wall makes the small ones hard to hit. */
        %>
        <div style="display:flex; flex-wrap:wrap; gap: var(--s-2); margin-top: var(--s-3);">
          <% for (const ph of a.photos) { %>
            <form method="post" action="/admin/media/<%= ph.id %>/album" style="width:96px;">
              <input type="hidden" name="_csrf" value="<%= csrf %>">
              <input type="hidden" name="album_slug" value="">
              <input type="hidden" name="back" value="albums">
              <img src="/media/<%= ph.storage_key %>" alt="<%= ph.alt %>"
                   width="96" height="72" loading="lazy" decoding="async"
                   style="width:96px; height:72px; object-fit:cover; display:block;
                          border-radius: var(--r-control); border:1px solid var(--hairline);">
              <button class="btn btn-quiet btn-sm" type="submit" style="width:100%; margin-top:4px;">Remove</button>
            </form>
          <% } %>
        </div>
      <% } %>

      <details style="margin-top: var(--s-4);">
        <summary style="cursor:pointer;">Edit This Album</summary>
        <form method="post" action="/admin/albums/save" style="margin-top: var(--s-3);">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="slug" value="<%= a.slug %>">
          <div class="field">
            <label for="title-<%= a.slug %>">Title</label>
            <input id="title-<%= a.slug %>" name="title" type="text" value="<%= a.title %>" required>
          </div>
          <div class="field">
            <label for="blurb-<%= a.slug %>">One Line</label>
            <input id="blurb-<%= a.slug %>" name="blurb" type="text" value="<%= a.blurb || '' %>">
          </div>
          <label class="check" for="pub-<%= a.slug %>">
            <input id="pub-<%= a.slug %>" type="checkbox" name="published" value="1" <%= a.published ? 'checked' : '' %>>
            <span>Published<span class="hint">An unpublished album keeps its photographs and shows nobody.</span></span>
          </label>
          <button class="btn" type="submit">Save Album</button>
        </form>

        <form method="post" action="/admin/albums/<%= a.slug %>/delete" style="margin-top: var(--s-3);">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="btn btn-danger btn-sm" type="submit">Delete This Album</button>
          <span class="hint" style="display:block; margin-top:4px;">
            The photographs are kept. They return to the unfiled list below.
          </span>
        </form>
      </details>
    </div>
  <% } %>
</section>

<%# ------------------------------------------------------------- new album %>
<section style="margin-top: var(--s-6);">
  <h2>Create an Album</h2>
  <%# An id, because the per-album edit forms below post to the same action and
      a selector that matches several forms is a selector that clicks the wrong
      one. %>
  <form id="new-album" class="panel" method="post" action="/admin/albums/save" style="margin-top: var(--s-3); max-width: 44rem;">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="row2">
      <div class="field">
        <label for="new-album-title">Title</label>
        <input id="new-album-title" name="title" type="text" required placeholder="Travel">
      </div>
      <div class="field">
        <label for="new-album-blurb">One Line</label>
        <input id="new-album-blurb" name="blurb" type="text">
      </div>
    </div>
    <label class="check" for="new-album-pub">
      <input id="new-album-pub" type="checkbox" name="published" value="1" checked>
      <span>Published</span>
    </label>
    <button class="btn" type="submit">Create Album</button>
  </form>
</section>

<%# --------------------------------------------------------------- unfiled %>
<section style="margin-top: var(--s-6);">
  <h2><%= unfiled.length %> Unfiled Photograph<%= unfiled.length === 1 ? '' : 's' %></h2>
  <p class="measure" style="color: var(--text-muted); font-size:.92rem;">
    In the library and in no album, so they appear nowhere on the personal page.
    This list exists because that is the one state nothing else on the site
    would show you.
  </p>

  <% if (!unfiled.length) { %>
    <p style="color: var(--text-muted); margin-top: var(--s-3);">Every photograph is filed.</p>
  <% } else if (!albums.length) { %>
    <p style="color: var(--text-muted); margin-top: var(--s-3);">Create an album first.</p>
  <% } else { %>
    <form class="panel" method="post" action="/admin/albums/assign" style="margin-top: var(--s-3);">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div style="display:flex; flex-wrap:wrap; gap: var(--s-3);">
        <% for (const m of unfiled) { %>
          <label style="width:112px; cursor:pointer;">
            <img src="/media/<%= m.storage_key %>" alt="<%= m.alt %>"
                 width="112" height="84" loading="lazy" decoding="async"
                 style="width:112px; height:84px; object-fit:cover; display:block;
                        border-radius: var(--r-control); border:1px solid var(--hairline);">
            <span style="display:flex; gap:6px; align-items:center; margin-top:5px; font-size:.78rem;">
              <input type="checkbox" name="media_id" value="<%= m.id %>">
              <span class="mono tnum" style="font-size:.62rem; color: var(--text-muted);">
                <%= m.width %>&times;<%= m.height %>
              </span>
            </span>
          </label>
        <% } %>
      </div>

      <div class="row2" style="margin-top: var(--s-4);">
        <div class="field">
          <label for="assign-album">File Into</label>
          <select id="assign-album" name="album_slug" required>
            <% for (const a of albums) { %><option value="<%= a.slug %>"><%= a.title %></option><% } %>
          </select>
        </div>
        <div class="field" style="justify-content:flex-end;">
          <button class="btn" type="submit">File the Selected Photographs</button>
        </div>
      </div>
    </form>
  <% } %>
</section>
