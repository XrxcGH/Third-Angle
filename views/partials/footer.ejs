<footer class="site-footer">
  <div class="wrap">
    <span><%= c('site.footer.line') %></span>
    <span>
      <a href="<%= c('site.github.url') %>" rel="me noopener"><%= c('site.footer.github') %></a> &middot;
      <a href="<%= c('site.linkedin.url') %>" rel="me noopener"><%= c('site.footer.linkedin') %></a> &middot;
      <a href="/contact"><%= c('site.footer.contact') %></a> &middot;
      <a href="/resume"><%= c('site.footer.resume') %></a> &middot;
      <a href="/now"><%= c('site.footer.now') %></a> &middot;
      <a href="/feed.xml"><%= c('site.footer.feed') %></a> &middot;
      <a href="/attributions"><%= c('site.footer.attributions') %></a> &middot;
      <%
        /* One link for both states. /admin sends a signed-in operator to the
           dashboard and everyone else to the sign in form, so the footer does
           not have to know which it is, and the public page does not have to
           load a session to render. */
      %>
      <a href="/admin"><%= c('site.footer.signin') %></a>
    </span>
  </div>
</footer>
