<%
  /*
   * The contact form, once.
   *
   * Two pages carry it, and a copied form is how one of them ends up missing a
   * honeypot or a stamp six months later. Everything it needs arrives as
   * locals: `stamp`, `errors`, `values`, and an optional `formId` so two forms
   * can coexist on one page without colliding label associations.
   */
  const id = (typeof formId === 'undefined' || !formId) ? 'c' : formId;
  const f = (name) => `${id}-${name}`;
%>

<% if (errors && errors.length) { %>
  <div class="flash error" role="alert" style="margin-top: var(--s-4);">
    <% for (const e of errors) { %><p style="margin:0;"><%= e %></p><% } %>
  </div>
<% } %>

<form method="post" action="/contact" class="panel" style="margin-top: var(--s-4);">
  <%
    /* A signed timestamp rather than a session, so the form works for a visitor
       who has never been given a cookie. The signature is what stops a bot
       posting a fabricated time to defeat the speed check. */
  %>
  <input type="hidden" name="t" value="<%= stamp %>">

  <%
    /* The honeypot. Moved off screen rather than display:none, which some bots
       now check for, and marked aria-hidden plus tabindex -1 so a screen reader
       and the keyboard both skip it. */
  %>
  <div class="honeypot" aria-hidden="true">
    <label for="<%= f('company') %>">Company</label>
    <input id="<%= f('company') %>" name="company" type="text" tabindex="-1" autocomplete="off">
  </div>

  <div class="row2">
    <div class="field">
      <label for="<%= f('name') %>">Your Name</label>
      <input id="<%= f('name') %>" name="name" type="text" required maxlength="120"
             autocomplete="name" value="<%= values.name %>">
    </div>
    <div class="field">
      <label for="<%= f('email') %>">Email</label>
      <input id="<%= f('email') %>" name="email" type="email" required maxlength="200"
             autocomplete="email" value="<%= values.email %>">
      <span class="hint">Only used to reply. Nothing else, ever.</span>
    </div>
  </div>

  <div class="field">
    <label for="<%= f('subject') %>">Subject</label>
    <input id="<%= f('subject') %>" name="subject" type="text" maxlength="200" value="<%= values.subject %>">
  </div>

  <div class="field">
    <label for="<%= f('message') %>">Message</label>
    <textarea id="<%= f('message') %>" name="message" required minlength="10" maxlength="5000"
              style="min-height: 10rem;"><%= values.message %></textarea>
  </div>

  <button class="btn" type="submit">Send</button>
</form>
