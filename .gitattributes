# Line endings.
#
# This repository is authored on Windows and deployed to Linux. Without this,
# git converts LF to CRLF on checkout, and a shell script with CRLF endings
# fails on the server with "bad interpreter: /usr/bin/env bash^M", which is a
# genuinely confusing error to hit at 1am during a restore.
#
# Everything textual is normalised to LF in the repository and checked out as
# LF everywhere, including on Windows. Nothing here needs CRLF.

* text=auto eol=lf

# Explicit for the files where it actually matters.
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.yml       text eol=lf
Caddyfile   text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.ejs       text eol=lf
*.css       text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.json      text eol=lf

# Binary, never touched.
*.woff2     binary
*.png       binary
*.jpg       binary
*.webp      binary
*.avif      binary
*.pdf       binary
*.glb       binary
*.mp4       binary
